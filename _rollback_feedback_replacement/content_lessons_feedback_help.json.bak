    {"stage_id": "INTRODUCTION", "feedback_field": "Primary Feedback", "selection_branch": "keyword_list_candidate", "lesson_id": "HELP-INTRODUCTION-DEVELOPMENT", "dimension": "Structure", "skill": "Introduction Development", "required_rule_ids": ["INTRO.TEXT.KEYWORD_LIST_CANDIDATE"], "mapping_basis": "The selected keyword-list branch and its emitted keyword-list event support review of short topic expressions. The prepared Structure label does not judge semantic development or generate an Introduction.", "noticed": "The checks flagged a possible list of topic expressions rather than developed statements."},
    {"stage_id": "INTRODUCTION", "feedback_field": "Primary Feedback", "selection_branch": "no_focus_match", "lesson_id": "HELP-TOPIC-VOCABULARY", "dimension": "Coherence", "skill": "Topic Vocabulary", "required_rule_ids": ["INTRO.TOPIC.NO_FOCUS_MATCH_OBSERVED"], "mapping_basis": "The selected no-focus branch and emitted absence event support whole-Introduction vocabulary review using existing direct/lemma counts. No semantic irrelevance is inferred.", "noticed": "No direct or lemma matches were recorded for the assignment focus terms in this Introduction. Different wording may still express a relevant idea."},
    {"stage_id": "INTRODUCTION", "feedback_field": "Primary Feedback", "selection_branch": "one_sentence_specific_focus_without_root_candidate", "lesson_id": "HELP-MAIN-POINT", "dimension": "Clarity", "skill": "Main Point", "mapping_basis": "This recorded one-sentence branch explicitly asks the writer to review an identifiable main point after specific focus wording matched but a root-clause candidate was absent. The label is a review purpose, not a finding that the writing is unclear.", "noticed": "Assignment words matched, but the checks could not identify their main-point sentence pattern. This does not prove that a main point is missing."},
    {"stage_id": "INTRODUCTION", "feedback_field": "Primary Feedback", "selection_branch": "no_root_subject_predicate_candidate", "lesson_id": "HELP-MAIN-POINT", "dimension": "Clarity", "skill": "Main Point", "mapping_basis": "The selected fallback asks the writer to review the main point; recorded absence under the root-clause heuristic motivates a question, not a classification of thesis clarity or completeness.", "noticed": "The checks could not identify their main-point sentence pattern. Unusual wording or a parser mistake can cause this result; it does not prove that your main point is missing."},
    {"stage_id": "INTRODUCTION", "feedback_field": "Primary Feedback", "selection_branch": "central_clause_with_multiple_clause_candidates", "lesson_id": "HELP-POINT-REASON", "dimension": "Coherence", "skill": "Point and Reason", "mapping_basis": "The backend selects point/reason connection review when central and multiple supported clause candidates exist. Coherence names that instructional question, not an assessed logical relationship or a verified reason.", "noticed": "EssayScaff found a sentence pattern that may express a main point, plus additional sentence-part patterns. It has not verified that those parts give a reason or that the reason supports your point."},
    {"stage_id": "BODY", "feedback_field": "Primary Feedback", "selection_branch": "first_paragraph_without_additional_clause_candidate", "lesson_id": "HELP-SUPPORTING-DETAIL", "dimension": "Structure", "skill": "Supporting Details", "mapping_basis": "The selected branch reviews development of one sentence-bearing paragraph with no structural detail candidates. Structure refers to paragraph development as a teaching skill; clause counts cannot establish the usefulness, accuracy or absence of real support.", "noticed": "In one Body paragraph, the checks did not find the extra sentence-part patterns they use as possible development signals. This is not a finding that your paragraph has no useful detail."},
    {"stage_id": "BODY", "feedback_field": "Primary Feedback", "selection_branch": "first_repeated_sentence_openings", "lesson_id": "HELP-REPEATED-OPENINGS", "dimension": "Structure", "skill": "Repeated Openings", "mapping_basis": "The selected backend branch reports repeated sentence openings inside one paragraph using recorded direct spans. Structure · Repeated Openings names the instructional review focus; repetition can also maintain continuity, so this is not a severity or quality judgment.", "noticed": "The checks recorded more than one sentence in a paragraph starting with the same words. Review whether the repetition sounds awkward in your own reading."},
    {"stage_id": "BODY", "feedback_field": "Primary Feedback", "selection_branch": "first_unlinked_adjacent_paragraph_pair", "lesson_id": "HELP-CONNECTING-IDEAS", "dimension": "Coherence", "skill": "Paragraph Connection", "mapping_basis": "A returned adjacent-paragraph comparison lacks a shared content lemma and listed transition. The branch requests connection review; lexical absence does not establish missing logical coherence.", "noticed": "For one neighboring paragraph pair, the checks did not record shared key words or a listed transition expression. You may still have connected the ideas using different wording."},
    {"stage_id": "CONCLUSION", "feedback_field": "Primary Feedback", "selection_branch": "closure_structure_candidate", "lesson_id": "HELP-CONCLUSION-PURPOSE", "dimension": "Structure", "skill": "Conclusion Purpose", "mapping_basis": "A final root-clause candidate or closing expression supplies an ending-position signal. The teaching focus is the purpose of an ending, not a validated conclusion-quality judgment.", "noticed": "The checks recorded a final sentence pattern or a closing expression. That is a possible ending signal, not proof that the ending works well."},
    {"stage_id": "CONCLUSION", "feedback_field": "Primary Feedback", "selection_branch": "synthesis_structure_candidate", "lesson_id": "HELP-CONCLUSION-PURPOSE", "dimension": "Structure", "skill": "Conclusion Alignment", "mapping_basis": "A clause-bearing Conclusion sentence contains at least two normalized concepts also observed in supplied prior sections. This supports a prepared review of how an ending returns to earlier material, not a claim of semantic alignment, synthesis quality or logical coherence.", "noticed": "One sentence contains words or phrases also recorded in the earlier sections supplied, allowing for different forms of the same words. This comparison does not prove that the sentence brings the ideas together."}
  ],
  "secondary_bindings": [
    {"stage_id": "INTRODUCTION", "rule_id_pattern": "^INTRO\\.CLAUSE\\.POSSIBLE_INCOMPLETE_SUBORDINATOR$", "lesson_id": "HELP-SENTENCE-COMPLETION", "dimension": "Clarity", "skill": "Sentence Completion", "mapping_basis": "When this fired event appears under Needs Attention while another branch is primary, the same prepared sentence-completion lesson and Clarity review focus apply. Only recorded fired events with paired provenance can select it."},
    {"stage_id": "INTRODUCTION", "rule_id_pattern": "^INTRO\\.TOPIC\\.NO_FOCUS_MATCH_OBSERVED$", "lesson_id": "HELP-TOPIC-VOCABULARY", "dimension": "Coherence", "skill": "Topic Vocabulary", "mapping_basis": "When the no-focus event appears under Needs Attention while another branch is primary, the prepared topic-vocabulary lesson reviews assignment wording only; it does not claim semantic irrelevance."},
    {"stage_id": "BODY", "rule_id_pattern": "^BODY\\.P\\d+\\.PARAGRAPH\\.FOCUS_TERMS_NOT_OBSERVED$", "lesson_id": "HELP-TOPIC-VOCABULARY", "dimension": "Coherence", "skill": "Topic Vocabulary", "mapping_basis": "When a paragraph focus-absence event appears under Needs Attention, the prepared topic-vocabulary lesson reviews assignment wording for that paragraph only; paraphrases may still be relevant."},
    {"stage_id": "BODY", "rule_id_pattern": "^BODY\\.P\\d+\\.SUPPORTING_DETAIL\\.NOT_OBSERVED$", "lesson_id": "HELP-SUPPORTING-DETAIL", "dimension": "Structure", "skill": "Supporting Details", "mapping_basis": "When a supporting-detail absence event appears under Needs Attention, the prepared supporting-details lesson reviews paragraph development only; clause counts cannot judge support quality."},
