<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f9fe">
  <meta name="csrf-token" content="{{ csrf_token }}">
  <title>EssayScaff V2 — Student Workspace</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <script src="{{ url_for('static', filename='app.js') }}" defer></script>
</head>
<body class="student-app" data-initial-view="dashboard">
  <header class="app-header">
    <a class="brand" href="#dashboard" data-app-link="dashboard" aria-label="EssayScaff Student Dashboard">
      <img class="brand-logo" src="{{ url_for('brand_logo') }}" alt="">
      <span class="brand-wordmark">EssayScaff <span>V2</span></span>
    </a>
    <div class="header-context"><span class="role-chip">Student</span><span class="header-page-label">Writing workspace</span></div>
    <div class="account-tools">
      <span>Signed in as <strong>{{ username }}</strong></span>
      <a class="account-settings-link" href="{{ url_for('account_settings') }}">Account</a>
      <form action="{{ url_for('logout') }}" method="post">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button class="logout-button" type="submit">Log out</button>
      </form>
    </div>
  </header>

  <div class="app-layout">
    <aside class="app-sidebar">
      <p class="sidebar-label">STUDENT SPACE</p>
      <nav class="app-navigation" aria-label="Student navigation">
        <a href="#dashboard" data-app-link="dashboard"><span class="nav-icon" aria-hidden="true">⌂</span>Dashboard</a>
        <a href="#classrooms" data-app-link="classrooms"><span class="nav-icon" aria-hidden="true">▦</span>My Classrooms</a>
        <a href="#assignments" data-app-link="assignments"><span class="nav-icon" aria-hidden="true">☷</span>My Assignments</a>
        <a href="#workspace" data-app-link="workspace"><span class="nav-icon" aria-hidden="true">✎</span>Writing Workspace</a>
      </nav>
      <div class="sidebar-note"><span class="sidebar-note-mark" aria-hidden="true">✦</span><p>Your ideas stay yours. EssayScaff helps you review your writing without rewriting it.</p></div>
    </aside>

    <main class="app-main" id="student-app-main">
      <div id="assignment-message" class="app-notice" role="status" aria-live="polite"></div>

      <section class="app-view" data-app-view="dashboard" aria-labelledby="dashboard-heading">
        <div class="page-heading">
          <p class="eyebrow">YOUR WRITING SPACE</p>
          <h1 id="dashboard-heading">Welcome back, {{ username }}.</h1>
          <p>Pick up where you left off or explore your classrooms and assignments.</p>
        </div>
        <div class="dashboard-grid">
          <section class="surface-card dashboard-classrooms-card" aria-labelledby="dashboard-classrooms-heading">
            <div class="section-title-row"><div><p class="eyebrow">LEARNING COMMUNITIES</p><h2 id="dashboard-classrooms-heading">Your classrooms</h2></div>
              <a class="text-link" href="#classrooms" data-app-link="classrooms">View all</a></div>
            <p id="my-classrooms-empty" class="empty-state" hidden>You have not joined a classroom yet.</p>
            <ul id="my-classroom-list" class="classroom-list"></ul>
            <button class="button-secondary compact-button" type="button" data-app-link="classrooms">Explore classrooms</button>
          </section>
          <section class="surface-card dashboard-assignments-card" aria-labelledby="dashboard-assignments-heading">
            <div class="section-title-row"><div><p class="eyebrow">KEEP MAKING PROGRESS</p><h2 id="dashboard-assignments-heading">Your assignments</h2></div>
              <a class="text-link" href="#assignments" data-app-link="assignments">View all</a></div>
            <p id="dashboard-assignments-empty" class="empty-state" hidden>Assignments from your classrooms will appear here.</p>
            <ul id="dashboard-assignment-list" class="dashboard-assignment-list"></ul>
          </section>
        </div>
        <section class="welcome-strip">
          <span class="welcome-icon" aria-hidden="true">✦</span>
          <div><h2>Writing grows one step at a time</h2><p>Draft a section, review the observations, and decide what you want to improve.</p></div>
          <a class="button-primary" href="#workspace" data-app-link="workspace">Open workspace</a>
        </section>
      </section>

      <section class="app-view" data-app-view="classrooms" aria-labelledby="classrooms-heading" hidden>
        <div class="page-heading page-heading-actions">
          <div><p class="eyebrow">YOUR LEARNING COMMUNITIES</p><h1 id="classrooms-heading">My Classrooms</h1><p>Find your class and see the assignments shared by your teacher.</p></div>
          <details class="join-classroom-panel">
            <summary class="button-primary">Join a classroom</summary>
            <form id="join-classroom-form" class="join-classroom-form">
              <label for="enrollment-code">Class enrollment code</label>
              <p class="field-help">Enter the code provided by your teacher.</p>
              <div class="join-form-row"><input id="enrollment-code" name="enrollment_code" type="text" maxlength="32" placeholder="e.g. A7K4P2Q9" autocomplete="off" required>
                <button type="submit">Join classroom</button></div>
            </form>
          </details>
        </div>
        <p id="classrooms-page-empty" class="empty-state" hidden>You have not joined a classroom yet. Use the button above to enter an enrollment code.</p>
        <ul id="classrooms-page-list" class="classrooms-grid"></ul>
      </section>

      <section class="app-view" data-app-view="assignments" aria-labelledby="assignments-heading" hidden>
        <div class="page-heading">
          <p class="eyebrow">YOUR NEXT STEPS</p><h1 id="assignments-heading">My Assignments</h1>
          <p>Review your teacher’s instructions, then open the writing workspace when you are ready.</p>
        </div>
        <section id="selected-classroom" class="selected-classroom-banner" hidden>
          <div><p class="eyebrow">FILTERED BY CLASSROOM</p><h2 id="selected-classroom-name"></h2><p id="selected-classroom-subtitle"></p></div>
          <button class="button-secondary compact-button" id="show-all-assignments" type="button">Show all assignments</button>
        </section>
        <section id="assignment-detail-view" class="surface-card assignment-detail-view" aria-labelledby="assignment-detail-title" hidden>
          <div class="section-title-row"><div><p class="eyebrow" id="assignment-detail-classroom"></p><h2 id="assignment-detail-title"></h2></div><span id="assignment-detail-progress" class="status-chip"></span></div>
          <p id="assignment-detail-topic" class="assignment-detail-topic"></p>
          <div class="assignment-detail-instructions"><h3>Teacher instructions</h3><p id="assignment-detail-instructions"></p></div>
          <p id="assignment-detail-focus" class="field-help"></p>
          <button id="open-assignment-workspace" class="button-primary" type="button">Start Writing</button>
        </section>
        <p id="assignments-empty" class="empty-state" hidden>No active assignments are available. Check back with your teacher.</p>
        <ul id="available-assignment-list" class="assignment-grid"></ul>
        <section id="archived-student-work" class="archived-student-work surface-card" hidden>
          <div class="section-title-row"><div><p class="eyebrow">YOUR SAVED RECORDS</p><h2>Archived assignments</h2></div><span class="status-chip">Read only</span></div>
          <p class="field-help">Your teacher has archived these assignments. Your previously saved writing remains available to you.</p>
          <ul id="archived-assignment-list" class="assignment-grid archived-assignment-list"></ul>
        </section>
      </section>

      <section class="app-view workspace-view" data-app-view="workspace" aria-labelledby="workspace-page-heading" hidden>
        <div class="page-heading workspace-page-heading">
          <div><p class="eyebrow">YOUR DRAFT, YOUR PROCESS</p><h1 id="workspace-page-heading">Writing Workspace</h1><p>Work through your essay one section at a time.</p></div>
          <button id="practice-mode-button" class="button-secondary" type="button">Free Writing / Practice</button>
        </div>
        <section id="workspace-assignment-context" class="workspace-context surface-card" aria-label="Assignment context">
          <div id="selected-assignment-details" class="selected-assignment-details" hidden>
            <div class="selected-assignment-heading"><div><p class="eyebrow">CURRENT ASSIGNMENT</p><h2 id="selected-assignment-title"></h2></div><p id="assignment-submitted-status" class="submission-status" hidden></p></div>
            <p id="selected-assignment-topic" class="assignment-topic-context"></p>
            <details class="assignment-instructions-panel"><summary>Teacher instructions and focus terms</summary><p id="selected-assignment-instructions"></p><p id="selected-assignment-focus-terms" class="field-help"></p></details>
          </div>
          <details id="practice-setup" class="practice-setup" open>
            <summary>Free Writing / Practice setup</summary>
            <div class="practice-fields">
              <div><label for="assignment-topic">Writing topic</label><input id="assignment-topic" name="assignment_topic" type="text" maxlength="500" placeholder="What would you like to write about?" autocomplete="off" required></div>
              <div><label for="focus-terms">Focus terms <span class="optional">Optional</span></label><input id="focus-terms" name="focus_terms" type="text" maxlength="2400" placeholder="Separate terms with commas" autocomplete="off"><p class="field-help">Use focus terms as a reference while drafting.</p></div>
            </div>
          </details>
        </section>
        <nav class="stage-navigation" aria-label="Essay stages">
          <button class="stage-tab active" type="button" data-stage="INTRODUCTION" aria-pressed="true">Introduction</button>
          <button class="stage-tab" type="button" data-stage="BODY" aria-pressed="false">Body</button>
          <button class="stage-tab" type="button" data-stage="CONCLUSION" aria-pressed="false">Conclusion</button>
          <button class="stage-tab" type="button" data-stage="ESSAY_REVIEW" aria-pressed="false">Essay Review</button>
        </nav>
        <div id="work-area" class="work-area">
          <section class="editor-card surface-card" aria-labelledby="stage-heading">
            <div class="card-heading editor-heading">
              <div><span class="step-label">STEP 1 OF 3</span><h2 id="stage-heading">Write Your Introduction</h2></div>
              <span class="draft-label">Your draft</span>
            </div>
            <label class="visually-hidden" for="stage-text">Write the selected essay stage</label>
            <div class="writing-editor">
              <div id="editor-backdrop" class="editor-backdrop" aria-hidden="true"><div id="editor-mirror" class="editor-mirror"></div></div>
              <textarea id="stage-text" name="stage_text" maxlength="12000" placeholder="Write your Introduction here…" required></textarea>
            </div>
            <div class="editor-footer"><span id="word-count" class="word-count" aria-live="polite">0 words</span><span class="field-help">Your writing will not be rewritten.</span></div>
            <div class="editor-actions workspace-actions">
              <button id="analyze-button" type="button">Analyze Now</button>
              <button id="save-button" class="button-secondary" type="button">Save Draft</button>
              <button id="save-revision-button" class="button-quiet" type="button">Save Revision</button>
            </div>
            <p id="save-status" class="save-status" role="status" aria-live="polite">Not saved</p>
            <p id="revision-save-status" class="save-status" role="status" aria-live="polite"></p>
            <p id="analysis-status" class="analysis-status" role="status" aria-live="polite">Feedback updates after a short pause. Analyze Now checks immediately. Analysis does not save your draft.</p>
            <p id="error-message" class="error-message" role="alert" hidden></p>
            <p class="draft-warning">Select Save Draft to store changes to your account. Unsaved changes are protected when you navigate within the app.</p>
          </section>
          <aside class="feedback-card surface-card" aria-labelledby="feedback-heading" aria-live="polite">
            <div class="card-heading feedback-heading"><div><span class="step-label">YOUR REVIEW</span><h2 id="feedback-heading">Writing Tutor</h2></div><span id="feedback-status" class="status-pill">Not analyzed</span></div>
            <div id="feedback-placeholder" class="tutor-state" role="status" aria-live="polite">
              <p id="tutor-state-title" class="tutor-state-title"></p>
              <p id="tutor-state-lead" class="tutor-state-lead"></p>
              <p id="tutor-state-detail" class="tutor-state-detail"></p>
              <span id="tutor-typing-dots" class="tutor-typing-dots" hidden aria-hidden="true"><span></span><span></span><span></span></span>
            </div>
            <div id="feedback-content" hidden>
              <p id="feedback-writing-focus" class="feedback-writing-focus" aria-label="Instructional writing focus, not an assessed score" hidden></p>
              <div id="tutor-tabs" class="tutor-tabs" role="tablist" aria-label="Writing feedback topics"></div>
              <section class="feedback-section tutor-section"><h3>What I noticed</h3><p id="tutor-noticed"></p></section>
              <section class="feedback-section tutor-section tutor-evidence-section"><h3>Look at your writing</h3><div id="tutor-evidence" class="tutor-evidence"></div></section>
              <section class="feedback-section tutor-section"><h3>Why it's a problem</h3><p id="tutor-why"></p></section>
              <section class="feedback-section tutor-section"><h3>How to improve it</h3><p id="tutor-try"></p><p id="tutor-check" class="tutor-self-check"></p></section>
              <p id="tutor-limitation" class="interpretation-limit"></p>
              <details id="feedback-details" class="feedback-details" hidden>
                <summary>Show more feedback</summary>
                <div class="feedback-details-content">
                  <section class="feedback-section"><h3>What’s Working</h3><ul id="whats-working"></ul></section>
                  <section class="feedback-section"><h3>Needs Attention</h3><ul id="needs-attention"></ul></section>
                </div>
              </details>
              <p id="interpretation-limit" class="interpretation-limit" hidden></p>
            </div>
          </aside>
        </div>
        <section id="introduction-guided-progression" class="guided-progression surface-card" aria-labelledby="guided-progression-heading" hidden>
          <div class="guided-progression-heading">
            <div><p class="eyebrow">GUIDED PROGRESSION</p><h2 id="guided-progression-heading">Before you continue to Body</h2></div>
            <span id="guided-state-label" class="guided-state-badge" data-state="NOT_STARTED">Not Started</span>
          </div>
          <p id="guided-state-message" class="guided-state-message" role="status" aria-live="polite">Start writing your Introduction. Introduce the topic and tell readers your main idea.</p>
          <ol class="guided-requirements">
            <li id="guided-item-topic" class="guided-requirement" data-guided-item="topic" tabindex="-1">
              <div class="guided-requirement-heading"><h3>1. Introduce the topic</h3><span id="guided-topic-status" class="guided-item-status">Not Checked</span></div>
              <p>Introduce the topic you are writing about.</p>
              <p id="guided-topic-note" class="guided-item-note"></p>
            </li>
            <li id="guided-item-thought" class="guided-requirement" data-guided-item="thought" tabindex="-1">
              <div class="guided-requirement-heading"><h3>2. Write a complete thought</h3><span id="guided-thought-status" class="guided-item-status">Not Checked</span></div>
              <p>Write at least one complete sentence that introduces your idea.</p>
              <p id="guided-thought-note" class="guided-item-note"></p>
            </li>
            <li id="guided-item-position" class="guided-requirement" data-guided-item="position" tabindex="-1">
              <div class="guided-requirement-heading"><h3>3. State your position</h3><span id="guided-position-status" class="guided-item-status">Not Checked</span></div>
              <label class="guided-self-check" for="guided-position-confirmed"><input id="guided-position-confirmed" type="checkbox" disabled> My Introduction clearly states my position.</label>
              <p id="guided-position-note" class="guided-item-note">This is your self-check; EssayScaff does not judge whether your position is clear.</p>
            </li>
            <li id="guided-item-direction" class="guided-requirement" data-guided-item="direction" tabindex="-1">
              <div class="guided-requirement-heading"><h3>4. Give a reason or direction</h3><span id="guided-direction-status" class="guided-item-status">Not Checked</span></div>
              <label class="guided-self-check" for="guided-direction-confirmed"><input id="guided-direction-confirmed" type="checkbox" disabled> My Introduction gives a reason or tells readers what I will explain.</label>
              <p id="guided-direction-note" class="guided-item-note">This is your self-check; EssayScaff does not judge whether the reason is meaningful.</p>
            </li>
          </ol>
          <p class="guided-progression-note">This is a progression checklist, not a writing-quality grade. Your confirmations are temporary and may need to be repeated after refreshing or making a substantial change.</p>
          <div class="guided-progression-actions">
            <button id="guided-review-suggestions" class="button-secondary" type="button" hidden>Review Suggestions</button>
            <button id="guided-continue-to-body" type="button" hidden>Continue to Body</button>
            <button id="guided-continue-anyway" class="button-quiet" type="button" hidden>Continue Anyway</button>
          </div>
        </section>
        <section id="introduction-tutoring" class="introduction-tutoring" aria-labelledby="introduction-tutoring-launcher-heading" hidden>
          <div class="introduction-tutoring-launcher">
            <div>
              <p class="eyebrow">OPTIONAL LESSON</p>
              <h2 id="introduction-tutoring-launcher-heading">Need help with your Introduction?</h2>
              <p id="introduction-lesson-suggestion" class="introduction-lesson-suggestion" role="status" aria-live="polite" hidden></p>
            </div>
            <button id="open-introduction-lesson" class="button-secondary" type="button">Learn how to write your Introduction</button>
          </div>
          <section id="introduction-lesson-panel" class="introduction-lesson-panel surface-card" aria-labelledby="introduction-lesson-title" hidden>
            <div class="introduction-lesson-heading">
              <div><p class="eyebrow" id="introduction-lesson-step-label">WRITING GUIDE</p><h2 id="introduction-lesson-title"></h2></div>
              <span id="introduction-lesson-progress" class="lesson-progress" aria-live="polite"></span>
            </div>
            <div id="introduction-lesson-content" class="introduction-lesson-content" tabindex="-1"></div>
            <p id="introduction-lesson-feedback" class="introduction-lesson-feedback" role="status" aria-live="polite"></p>
            <div class="introduction-lesson-actions">
              <button id="introduction-lesson-return" class="button-secondary" type="button">Return to Writing</button>
            </div>
          </section>
        </section>
        <script id="introduction-lesson-definition" type="application/json">{{ introduction_lesson|tojson }}</script>
        <script id="scaffolding-guidance-definition" type="application/json">{{ feedback_help|tojson }}</script>
        <section id="nlp-transparency" class="analysis-export surface-card" aria-labelledby="analysis-export-heading">
          <div class="transparency-dashboard-heading">
            <div>
              <p class="eyebrow">TECHNICAL TRANSPARENCY</p>
              <h2 id="analysis-export-heading">How EssayScaff Analyzed Your Writing</h2>
              <p class="transparency-lead">Follow your words to feedback. Choose a processing tab, then an evidence view.</p>
            </div>
            <div class="transparency-export-controls">
              <button id="transparency-focus-toggle" class="button-quiet" type="button" aria-pressed="false" hidden>Show transparency full-screen</button>
              <button id="copy-full-analysis" class="button-secondary" type="button" aria-describedby="analysis-copy-status analysis-copy-notice" disabled>Copy Full Analysis</button>
              <p id="analysis-copy-status" class="analysis-copy-status" role="status" aria-live="polite">Analyze the current draft first to copy its full analysis.</p>
              <p id="analysis-copy-notice" class="field-help">The copied report includes your writing and may contain assignment information.</p>
            </div>
          </div>
          <div id="analysis-copy-fallback" class="analysis-copy-fallback" hidden>
            <label for="full-analysis-report">Full analysis — manual copy</label>
            <p id="analysis-copy-instructions" class="field-help">Select the report below and press Ctrl+C (Windows) or Command+C (Mac), or use your device’s Copy command.</p>
            <textarea id="full-analysis-report" readonly spellcheck="false" aria-describedby="analysis-copy-instructions"></textarea>
          </div>
          <div id="nlp-transparency-content"><p>Analyze your current writing first to see how EssayScaff processed it. Analyzing does not save your draft.</p></div>
        </section>
        <details id="revision-card" class="revision-card surface-card">
          <summary class="revision-summary"><span><span class="eyebrow">WRITING RECORD</span><strong>Revision History</strong></span><span id="revision-empty" class="field-help">Save a revision to begin your history.</span></summary>
          <ol id="revision-list" class="revision-list" hidden></ol>
          <section id="revision-preview" class="revision-preview" aria-live="polite" hidden>
            <h3 id="revision-preview-title">Viewing revision</h3>
            <div class="preview-stage"><h4>Introduction</h4><pre id="preview-introduction"></pre></div>
            <div class="preview-stage"><h4>Body</h4><pre id="preview-body"></pre></div>
            <div class="preview-stage"><h4>Conclusion</h4><pre id="preview-conclusion"></pre></div>
          </section>
        </details>
        <section id="essay-review-panel" class="essay-review-card surface-card" aria-labelledby="essay-review-heading" hidden>
          <div class="card-heading"><div><p class="eyebrow">READ-ONLY PREVIEW</p><h2 id="essay-review-heading">Essay Review</h2></div></div>
          <div class="review-topic"><span class="review-topic-label">Assignment topic</span><p id="review-assignment-topic"></p></div>
          <p id="review-unsaved-note" class="review-unsaved-note" hidden>Preview includes unsaved changes.</p>
          <div id="submission-controls" class="submission-controls" hidden><button id="submit-essay-button" type="button">Submit Essay</button><p id="submission-status" class="submission-status" role="status" aria-live="polite"></p><p id="submission-error" class="error-message" role="alert" hidden></p></div>
          <div class="essay-sections">
            <section class="essay-section"><h3>Introduction</h3><pre id="review-introduction"></pre></section>
            <section class="essay-section"><h3>Body</h3><pre id="review-body"></pre></section>
            <section class="essay-section"><h3>Conclusion</h3><pre id="review-conclusion"></pre></section>
          </div>
          <section class="essay-statistics" aria-labelledby="essay-statistics-heading"><h3 id="essay-statistics-heading">Word counts</h3><dl>
            <div><dt>Introduction</dt><dd id="review-introduction-count">0</dd></div><div><dt>Body</dt><dd id="review-body-count">0</dd></div><div><dt>Conclusion</dt><dd id="review-conclusion-count">0</dd></div><div class="total-count"><dt>Total essay</dt><dd id="review-total-count">0</dd></div>
          </dl><p>Counts use whitespace-separated words.</p></section>
        </section>
      </section>
      <footer class="app-footer">EssayScaff offers observations to support your writing process. Your ideas and decisions remain yours.</footer>
    </main>
  </div>
</body>
</html>
